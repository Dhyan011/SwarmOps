# ─── OpenRouter & GitHub Configuration ───
OPENROUTER_API_KEY=your_openrouter_api_key_here
GITHUB_TOKEN=your_github_personal_access_token
# Supabase Auth: backend verifies token signature, issuer, audience, and expiry.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional legacy HS256 signing secret; prefer asymmetric keys/JWKS where available.
SUPABASE_JWT_SECRET=
# Explicit async PostgreSQL URL required for production. No JSON fallback is used.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/swarmops
APP_ENV=production
CORS_ALLOWED_ORIGINS=https://swarmops-frontend.onrender.com

# ─── Azure Log Analytics ───
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your_workspace_id_here

# ─── Azure AI Search ───
AZURE_AI_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_AI_SEARCH_KEY=your_search_key_here

# ─── Azure Service Principal ───
AZURE_CLIENT_ID=your_client_id_here
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
