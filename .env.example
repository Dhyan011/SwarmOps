# ─── BYOK credential encryption (backend-only, 32 random bytes, base64url) ───
# Generate: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
BYOK_ENCRYPTION_KEY=
# GitHub App integration: private key remains backend-only; never use a shared user token.
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-real-private-key\n-----END PRIVATE KEY-----"
PUBLIC_BASE_URL=https://your-backend.example.com
APP_STATE_SECRET=generate-a-long-random-secret-with-at-least-32-characters
# Supabase Auth: backend verifies token signature, issuer, audience, and expiry.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional legacy HS256 signing secret; prefer asymmetric keys/JWKS where available.
SUPABASE_JWT_SECRET=
# Explicit async PostgreSQL URL required for production. No JSON fallback is used.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/swarmops
APP_ENV=production
CORS_ALLOWED_ORIGINS=https://swarmops-frontend.onrender.com
MAX_CONCURRENT_INVESTIGATIONS=3
INVESTIGATION_QUEUE_WAIT_SECONDS=5
INVESTIGATION_TIMEOUT_SECONDS=900

# ─── Azure Log Analytics ───
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your_workspace_id_here

# ─── Azure AI Search ───
AZURE_AI_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_AI_SEARCH_KEY=your_search_key_here

# ─── Azure Service Principal ───
AZURE_CLIENT_ID=your_client_id_here
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
